frontend/node_modules/
frontend/.next/
frontend/next-env.d.ts
frontend/.env.local
frontend/tsconfig.tsbuildinfo

# Editors / OS
.vscode/
.DS_Store

# Local Claude Code session state (tool permissions, etc.) -- not product code
.claude/
